#!/usr/bin/env node
const Colors = require('colors/safe')
const Crypto = require('crypto')
const fetch = require('node-fetch')
const FS = require('fs/promises')
const Http = require('http')
const Https = require('https')
const Mime = require('mime')
const Moment = require('moment')
const Path = require('path')
const {
    Auth,
    TokenStore,
    startBrowserLogin,
    startDeviceLogin,
} = require('../lib/auth')
const { quickXorHash } = require('../lib/quickxorhash')

// The $XDG_STATE_HOME directory contains state data that should persist between (application) restarts.
const TOKEN_PATH = Path.join(
    process.env.XDG_STATE_HOME || require('os').homedir(),
    '.onedrive-cli-token'
)
// Microsoft Graph. ONEDRIVE_GRAPH_URL points at a national cloud (e.g.
// https://graph.microsoft.us/v1.0) or a local mock for testing.
const API_BASE_URL = (
    process.env.ONEDRIVE_GRAPH_URL || 'https://graph.microsoft.com/v1.0'
).replace(/\/+$/, '')
// The signed-in user's own drive: OneDrive for personal accounts, OneDrive for
// Business for work or school accounts.
const DRIVE = '/me/drive'
const VERSION = require('../package.json').version

const tokenStore = new TokenStore(TOKEN_PATH)
const auth = new Auth(tokenStore)

const httpAgent = new Http.Agent({ keepAlive: true })
const httpsAgent = new Https.Agent({ keepAlive: true })
// node-fetch picks the agent per request. Plain http is only ever used with a
// local ONEDRIVE_GRAPH_URL (tests); Graph itself is https.
const agent = url => (url.protocol === 'http:' ? httpAgent : httpsAgent)

function makeAbsolute(url) {
    return /^https?:\/\//.test(url) ? url : API_BASE_URL + url
}

async function checkResponse(response) {
    debugPrint(response.status, response.statusText)
    const location = response.headers.get('location')
    if (response.status === 202 && location) {
        const locationURL = new URL(location, response.url)
        console.warn(Colors.yellow('GET'), locationURL.href)
        response = await fetch(locationURL)
    }
    if (!response.ok) {
        const contentType = response.headers.get('content-type') || ''
        if (!contentType.startsWith('application/json')) {
            const msg = await response.text()
            throw Object.assign(Error(msg), { statusCode: response.status })
        }
        const json = await response.json()
        const error = json.error || {}
        // Throw a real Error (not the bare API object) so the message is
        // readable everywhere -- otherwise callers that stringify it, like the
        // MCP layer, surface a useless "[object Object]". Spread the API error
        // before the computed fields so an empty/missing error.message can't
        // clobber the fallback. Carry statusCode so callers can detect auth
        // failures (401) and permission errors (403).
        throw Object.assign(
            new Error(
                error.message ||
                    error.code ||
                    response.statusText ||
                    'Request failed'
            ),
            error,
            { statusCode: response.status }
        )
    }
    return response
}

function sha1hash(data) {
    const sha1 = Crypto.createHash('sha1').update(data).digest('hex')
    return sha1
}

function padLeft(str, len) {
    return String('                ' + str).slice(-len)
}

function padRight(str, len) {
    return str + ' '.repeat(len - str.length)
}

function debugPrint(...data) {
    if (process.stdout.isTTY && process.env.NODE_ENV === 'development') {
        console.debug(...data)
    }
}

function print(data) {
    // FIXME(#70): a false return means stdout is backed up; without
    // hooking 'drain' the rest of a large file buffers in memory.
    process.stdout.write(data)
}

function humanize(num) {
    const units = ['', 'Ki', 'Mi', 'Gi', 'Ti', 'Pi']
    let div = 0
    for (;;) {
        const str = Math.round(num / Math.pow(1024, div))
        if (str <= 9999) {
            return str + units[div]
        }
        ++div
    }
}

function prettyPrint(num) {
    return padLeft(humanize(num), 6)
}

// The consumer OneDrive backend intermittently answers 503 (e.g.
// itemDisabledDueToUserContentMigration while Microsoft migrates accounts to
// the new photos stack) or throttles with 429, and an immediate retry
// typically succeeds. Honor Retry-After when the server sends one. Bodies are
// always buffered strings/Buffers here (never streams), so re-sending is safe.
async function fetchRetry(url, options, attempts = 3) {
    for (let attempt = 1; ; ++attempt) {
        const resp = await fetch(url, options)
        if (
            (resp.status !== 503 && resp.status !== 429) ||
            attempt >= attempts
        ) {
            return resp
        }
        const after = Number(resp.headers.get('retry-after')) || attempt
        if (process.stdout.isTTY) {
            console.warn(
                Colors.yellow(String(resp.status)),
                'retrying in ' + after + 's'
            )
        }
        await new Promise(resolve => setTimeout(resolve, after * 1000))
    }
}

// Every authenticated request goes through here. The access token is read
// fresh from disk each time -- a ~1KB read next to each HTTPS round-trip is
// negligible, and it means a re-login (even from another process, e.g. the CLI)
// is picked up immediately by the long-running MCP server -- and renewed first
// when it is about to expire. If Graph still answers 401 (e.g. the token was
// revoked early), renew once and retry.
async function send(url, options = {}) {
    url = makeAbsolute(url)
    const attempt = async forceRefresh =>
        fetchRetry(url, {
            agent,
            ...options,
            headers: {
                ...options.headers,
                Authorization:
                    'Bearer ' + (await auth.accessToken({ forceRefresh })),
            },
        })
    const resp = await attempt(false)
    if (resp.status !== 401) {
        return resp
    }
    if (await auth.canRefresh()) {
        return attempt(true)
    }
    if ((await tokenStore.read()).legacy) {
        throw Object.assign(
            Error(
                'The saved access token has expired, or was issued for the old ' +
                    "OneDrive API. Run '" +
                    commandName() +
                    " login' to sign in again."
            ),
            { statusCode: 401 }
        )
    }
    return resp
}

async function call(url, method, body, headers = {}) {
    const options = {
        body: body,
        method: method || 'GET',
        headers: {
            'Content-Type': 'application/octet-stream',
            Accept: 'application/json',
            ...headers,
        },
    }
    if (process.stdout.isTTY) {
        console.warn(Colors.yellow(options.method), decodeURIComponent(url))
    }

    // File content is sent as is: Graph does not document Content-Encoding on
    // uploads, so a gzipped body could be stored compressed.
    if (body !== undefined && !(body instanceof Buffer)) {
        options.body = JSON.stringify(body)
        options.headers['Content-Type'] = 'application/json'
    }

    const resp = await send(url, options)
    const data = await checkResponse(resp)
    return data.json()
}

async function getContent(url) {
    if (process.stdout.isTTY) {
        console.warn(Colors.yellow('GET'), decodeURIComponent(url))
    }

    const resp = await send(url)
    const data = await checkResponse(resp)
    return data.buffer()
}

// Download only [offset, offset+length) of a file via an HTTP Range request,
// so large files never come down whole. Returns the bytes plus the total size
// parsed from Content-Range (undefined if the server didn't report it).
async function getRange(url, offset, length) {
    const resp = await send(url, {
        // Byte ranges are only meaningful on the identity representation, so
        // don't let node-fetch negotiate/inflate gzip (partial gzip won't
        // decode, and offsets wouldn't line up with the file's bytes).
        compress: false,
        headers: {
            Range: 'bytes=' + offset + '-' + (offset + length - 1),
        },
    })
    const total = (cr => {
        const m = cr && /\/\s*(\d+)\s*$/.exec(cr)
        return m ? Number(m[1]) : undefined
    })(resp.headers.get('content-range'))
    // Range past EOF: report an empty tail instead of throwing.
    if (resp.status === 416) {
        return { buffer: Buffer.alloc(0), total }
    }
    await checkResponse(resp)
    let buffer = await resp.buffer()
    if (resp.status === 200) {
        // Server ignored the Range and sent the whole file; slice locally so
        // the result is still correct (no bandwidth win in this fallback).
        return {
            buffer: buffer.subarray(offset, offset + length),
            total: buffer.length,
        }
    }
    return { buffer, total }
}

function sanitize(remote) {
    const path = remote.replace(/^:?\/?\.?/, '').replace(/\/+$/, '')
    // Graph addresses the root itself as /root, not as an empty path.
    if (path === '') {
        return DRIVE + '/root'
    }
    // Escape all characters except the path delimiter '/'
    return (
        DRIVE + '/root:/' + encodeURIComponent(path).replace(/%2f/gi, '/') + ':'
    )
}

// The ':/'-prefixed path of an item. parentReference.path reads like
// /drive/root:/Folder, or /drives/{id}/root:/Folder for an item addressed by
// drive. Some responses (e.g. search on work accounts) carry no path at all;
// fall back to the bare name rather than fail.
function absolute(info) {
    const path = info.parentReference && info.parentReference.path
    if (!path) {
        return info.name
    }
    const parent = path.replace(/^\/drive(?:s\/[^/]+)?\/root/, '')
    return decodePath(parent) + '/' + info.name
}

// The path comes percent-encoded; a stray '%' in a folder name must not turn
// a listing into a URIError.
function decodePath(path) {
    try {
        return decodeURIComponent(path)
    } catch {
        return path
    }
}

/*
Filesystem         Size   Used  Avail Capacity Deleted
dc1e3335a482dc20 1214Gi  164Gi 1050Gi      14%   780Mi
*/
async function df() {
    const result = await call('/me/drives')
    console.log(
        Colors.bold(
            'Drive              Size   Used  Avail Capacity Deleted Status'
        )
    )
    for (const drive of result.value) {
        const capacity =
            Math.round((drive.quota.used * 100) / drive.quota.total) + '% '
        console.log(
            padRight(drive.id, 16),
            prettyPrint(drive.quota.total),
            prettyPrint(drive.quota.used),
            prettyPrint(drive.quota.remaining),
            padLeft(capacity, 9),
            prettyPrint(drive.quota.deleted),
            drive.quota.state || ''
        )
    }
}

async function ls_paged(total, cont) {
    if (cont === undefined) {
        return total
    }

    const result = await call(cont)
    const now = Moment()
    const threshold = 1000 * 60 * 60 * 24 * 180 //180days
    for (const f of result.value) {
        const m = Moment(f.lastModifiedDateTime)
        const d = 'folder' in f
        let mod = d ? 'drwx' : '-rw-'
        if ('shared' in f) {
            if (
                'effectiveRoles' in f.shared &&
                f.shared.effectiveRoles.length === 1 &&
                f.shared.effectiveRoles[0] === 'read'
            ) {
                mod += d ? 'r-x' : 'r--'
                if (f.shared.scope === 'anonymous') {
                    mod += d ? 'r-x' : 'r--'
                } else {
                    mod += '---'
                }
            } else {
                mod += d ? 'rwx' : 'rw-'
                if (f.shared.scope === 'anonymous') {
                    mod += d ? 'rwx' : 'rw-'
                } else {
                    mod += '---'
                }
            }
        } else {
            mod += '------'
        }
        const count = d ? f.folder.childCount : 1
        total += count
        // On work accounts an item can be created by an application or a
        // system account rather than a user.
        const by = f.createdBy && (f.createdBy.user || f.createdBy.application)
        console.log(
            mod,
            padLeft(count, 3),
            (by && by.displayName) || '',
            padLeft(f.size, 10),
            m.format(
                Math.abs(now - m) < threshold ? 'MMM DD HH:mm' : 'MMM DD  YYYY'
            ),
            d ? Colors.bold(Colors.blue(f.name)) + '/' : f.name
        )
    }
    return ls_paged(total, result['@odata.nextLink'])
}

async function ls(folders) {
    if (folders.length === 0) {
        folders = ['']
    }

    //console.log(Colors.bold('Permission Cnt Owner            Size     Date         Name'))
    let result = 0
    for (const folder of folders) {
        result = await ls_paged(result, sanitize(folder) + '/children')
    }
    return 'total ' + result
}

const MOVE = 'move'
const COPY = 'copy'

// Check an uploaded file against the hash the server computed. Work and school
// accounts report only quickXorHash; personal accounts report quickXorHash
// and, on older items, sha1Hash. Use whichever is there.
function verifyUpload(data, item, target) {
    const hashes = (item.file && item.file.hashes) || {}
    if (hashes.quickXorHash) {
        if (quickXorHash(data) !== hashes.quickXorHash) {
            throw Error('quickXorHash mismatch: ' + target)
        }
    } else if (hashes.sha1Hash) {
        if (sha1hash(data).toUpperCase() !== hashes.sha1Hash.toUpperCase()) {
            throw Error('sha1Hash mismatch: ' + target)
        }
    }
}

/*
PUT /me/drive/root:/{parent-path}/{filename}:/content
@microsoft.graph.conflictBehavior   fail, replace (def), or rename.
*/
async function upload(op, from, target, options = {}) {
    if (from.endsWith('/')) {
        throw Error('Invalid source name')
    }
    if (target.endsWith('/')) {
        target = target + Path.basename(from)
    }
    target = sanitize(target)
    let replace = options.overwrite === REPLACE
    if (options.overwrite === ASK) {
        const exists = await call(target).then(
            () => true,
            err => {
                if (err.statusCode === 404) {
                    return false
                }
                throw err
            }
        )
        if (exists && !(await confirm('overwrite ' + target + '?'))) {
            return console.log(from, '--', target, '(not overwritten)')
        }
        replace = exists
    }
    const mime = Mime.lookup(from)
    const data = await FS.readFile(from)
    // TODO(#36): skip the PUT when the target's hash already matches
    let result
    try {
        result = await call(
            target +
                '/content?@microsoft.graph.conflictBehavior=' +
                (replace ? 'replace' : 'fail'),
            'PUT',
            data,
            { 'Content-Type': mime }
        )
    } catch (err) {
        if (options.overwrite === SKIP && err.code === 'nameAlreadyExists') {
            return console.log(from, '--', target, '(exists, skipped)')
        }
        throw err
    }
    verifyUpload(data, result, target)
    try {
        if (op === MOVE) {
            console.log(from, '=>', target, result.id)
            await FS.unlink(from)
        } else {
            console.log(from, '->', target, result.id)
        }
    } catch (err) {
        if (err.statusCode === 404) {
            // A 404 on the PUT is how the API reports the simple-upload
            // size cap; resumable sessions are #33.
            return console.error(
                'Skipped. Uploads larger than 100MiB are not yet supported.'
            )
        }
        throw err
    }
}

/*
POST /me/drive/items/{parent-item}/children
Content-Type: application/json
Prefer: respond-async

{
  "@content.sourceUrl": "http://wscont2.apps.microsoft.com/winstore/1x/e33e38d9-d138-42a1-b252-27da1924ca87/Screenshot.225037.100000.jpg",
  "name": "halo-screenshot.jpg",
  "file": { }
}
*/
async function wget(args) {
    if (args.length !== 2) {
        console.error('usage: wget url target')
    } else {
        let target = args.pop()
        const from = args[0].startsWith('http') ? args[0] : 'http://' + args[0]
        // Upload from URL is only available on personal accounts.
        const data = {
            '@microsoft.graph.sourceUrl': from,
            name: Path.basename(target),
            file: {},
        }
        if (data.name === '' || target.endsWith('/')) {
            throw Error('Invalid target name')
        }
        let path = Path.dirname(target + 'hack')
        target = sanitize(target)
        path = sanitize(path)
        await call(path + '/children', 'POST', data, {
            Prefer: 'respond-async',
        })
        console.log(from, '-->', target)
    }
}

/*
GET /me/drive/root:/{path and filename}:/content
*/
async function download(op, from, target, options = {}) {
    if (from.endsWith('/')) {
        throw Error('Invalid source name')
    }
    if (target === undefined || target === '.' || target === '') {
        target = './'
    }
    if (target.endsWith('/')) {
        target = target + Path.basename(from)
    }
    const remote = sanitize(from)
    if (options.overwrite === SKIP || options.overwrite === ASK) {
        const exists = await FS.stat(target).then(
            () => true,
            () => false
        )
        if (
            exists &&
            (options.overwrite === SKIP ||
                !(await confirm('overwrite ' + target + '?')))
        ) {
            return console.log(from, '--', target, '(exists, skipped)')
        }
    }
    // TODO(#36): skip the GET when the local file's SHA1 already matches
    const data = await getContent(remote + '/content')
    await FS.writeFile(target, data)
    if (op === MOVE) {
        console.log(from, '=>', target)
        return rmItem(from)
    } else {
        console.log(from, '->', target)
    }
}

/*
PATCH /me/drive/items/{item-id}
Content-type: application/json

{
  "parentReference": {
    "id": "{new-parent-folder-id}"
  },
  "name": "new-item-name.txt"
}
*/
async function moveItem(item, path, name) {
    // Graph moves by parent id. Resolving it also avoids putting a URL-escaped
    // path into the JSON body (#71).
    const parent = await call(sanitize(path))
    const data = {
        name: name,
        parentReference: { id: parent.id },
    }
    return call(sanitize(item), 'PATCH', data)
}

async function rename(from, target) {
    if (from.endsWith('/')) {
        throw Error('Invalid source name')
    }
    if (target.endsWith('/')) {
        target = target + Path.basename(from)
    }
    const parent = Path.dirname(target)
    const name = Path.basename(target)
    await moveItem(from, parent, name)
    console.log(`renamed '${from}' -> '${target}'`)
}

async function cp_mv(op, args, target, options = {}) {
    if (args.length === 0) {
        return
    }

    if (args.length > 1 && !target.endsWith('/')) {
        throw Error('Target is not a directory')
    }

    if (args[0].startsWith('./') && target.startsWith('./')) {
        throw Error(`Local ${op} is not implemented.`)
    }

    if (args[0].startsWith(':/') && target.startsWith(':/')) {
        if (op !== MOVE) {
            throw Error(`Remote ${op} is not implemented.`)
        }
        // from onedrive to onedrive
        for (const cur of args) {
            await rename(cur, target)
        }
    } else if (args[0].startsWith('./') || target.startsWith(':/')) {
        // from local to onedrive
        for (const cur of args) {
            await upload(op, cur, target, options)
        }
    } else if (
        args[0].startsWith(':/') ||
        target.startsWith('./') ||
        target === '.'
    ) {
        // from onedrive to local
        for (const cur of args) {
            await download(op, cur, target, options)
        }
    } else {
        throw Error('Use ./ or :/ path prefix for local or remote paths.')
    }
}

async function cp_paged(cont, target, options) {
    if (cont === undefined) {
        return
    }
    const result = await call(cont)
    // TODO(#71): copy by Item ID instead of path?
    const files = result.value.filter(info => !is_folder(info)).map(absolute)
    await cp_mv(COPY, files, target + '/', options)
    await cp_paged(result['@odata.nextLink'], target, options)
    // Recurse into subfolders
    const folders = result.value.filter(is_folder)
    for (const info of folders) {
        const folder = Path.join(target, info.name)
        await FS.mkdir(folder, { recursive: true })
        await cp_paged(sanitize(absolute(info)) + '/children', folder, options)
    }
}

function is_folder(info) {
    return info.folder || (info.package && info.package.type === 'oneNote')
}

// What to do when the target exists: the last of -f, -i or -n wins, as in
// cp(1). Without any, uploads refuse to overwrite and downloads overwrite.
const REPLACE = 'replace' // -f
const ASK = 'ask' // -i
const SKIP = 'skip' // -n

// Leading options of cp and mv: -R (cp only), -t directory, -f, -i, -n, also
// combined (-Rf).
function parseCopyOptions(args, allowed) {
    const options = {}
    while (args.length > 0 && /^-[A-Za-z]+$/.test(args[0])) {
        for (const flag of args.shift().slice(1)) {
            if (!allowed.includes(flag)) {
                throw Error('Unknown option: -' + flag)
            }
            if (flag === 'R' || flag === 'r') {
                options.recursive = true
            } else if (flag === 't') {
                options.directory = args.shift()
            } else {
                options.overwrite = { f: REPLACE, i: ASK, n: SKIP }[flag]
            }
        }
    }
    return options
}

// Ask on the terminal (or read the answer from stdin); yes starts with y.
function confirm(question) {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stderr,
    })
    return new Promise(resolve =>
        readline.question(question + ' (y/n [n]) ', answer => {
            readline.close()
            resolve(/^y/i.test(answer.trim()))
        })
    )
}

async function cp(args) {
    const options = parseCopyOptions(args, 'Rrtfin')
    if (args.length < (options.directory ? 1 : 2)) {
        console.error('usage: cp [-R] [-f | -i | -n] source target')
        console.error('       cp [-R] [-f | -i | -n] source ... directory')
        console.error('       cp [-f | -i | -n] -t directory source ...')
        return
    }
    const target = options.directory || args.pop()
    if (!options.recursive) {
        return cp_mv(COPY, args, target, options)
    }
    for (const folder of args) {
        await cp_paged(sanitize(folder) + '/children', target, options)
    }
}

// DELETE returns 204 No Content on success, so don't go through call()
// (which would try to parse a JSON body that isn't there).
async function del(url) {
    if (process.stdout.isTTY) {
        console.warn(Colors.yellow('DELETE'), decodeURIComponent(url))
    }
    const resp = await send(url, { method: 'DELETE' })
    await checkResponse(resp)
}

/*
DELETE /me/drive/root:/{path}:
Returns 204 No Content on success.
Supports files and folders (recursive delete).
*/
function rmItem(remote) {
    return del(sanitize(remote))
}

async function rm(args) {
    if (args.length < 1) {
        console.error('usage: rm file ...')
    } else {
        for (const cur of args) {
            await rmItem(cur)
            console.log(`removed '${cur}'`)
        }
    }
}

function mv(args) {
    const options = parseCopyOptions(args, 'tfin')
    if (args.length < (options.directory ? 1 : 2)) {
        console.error('usage: mv [-f | -i | -n] source target')
        console.error('       mv [-f | -i | -n] source ... directory')
        console.error('       mv [-f | -i | -n] -t directory source ...')
        return
    }
    const target = options.directory || args.pop()
    return cp_mv(MOVE, args, target, options)
}

/*
POST /me/drive/items/{parent-item}/children
Content-Type: application/json

{
  "name": "New Folder",
  "file": { }
}
*/
function createFolder(parent, name) {
    const remote = sanitize(parent)
    const data = {
        name: name,
        folder: {},
    }
    return call(remote + '/children', 'POST', data)
}

async function mkdir1(dir) {
    const parent = Path.dirname(dir)
    const name = Path.basename(dir)
    const result = await createFolder(parent, name)
    console.log(`mkdir: created directory '${result.name}'`)
}

async function mkdir(args) {
    if (args.length < 1) {
        console.error('usage: mkdir directory_name ...')
    } else {
        for (const cur of args) {
            await mkdir1(cur)
        }
    }
}

async function cat1(remote) {
    remote = sanitize(remote)
    const data = await getContent(remote + '/content')
    print(data)
}

async function cat(args) {
    if (args.length < 1) {
        console.error('usage: cat file ...')
    } else {
        for (const cur of args) {
            await cat1(cur)
        }
    }
}

// How the user invoked us, so the landing page can echo a runnable command.
// Whatever this returns is pasted into a shell verbatim, so every branch has
// to be runnable on its own: a short path relative to the cwd when we live
// there (e.g. 'bin/onedrive'), the bare name when we are on the PATH (e.g. an
// installed 'onedrive-cli'), and an absolute path otherwise.
function commandName() {
    const argv1 = process.argv[1] || 'onedrive-cli'
    const rel = Path.relative(process.cwd(), argv1)
    const parts = rel.split(Path.sep)
    // Keep a relative path only while it stays short and below the cwd. A cwd
    // *above* us yields a long relative path that reads like a mangled
    // absolute one -- from '/' this file becomes
    // 'Users/me/dev/onedrive-cli/bin/onedrive', missing its leading slash.
    if (rel && parts.length <= 2 && !rel.startsWith('..')) {
        // A bare name only runs as './name'; with a folder it already does.
        return parts.length === 1 ? '.' + Path.sep + rel : rel
    }
    // On the PATH: the bare name is what the user typed and what reads best.
    const dirs = (process.env.PATH || '').split(Path.delimiter)
    if (dirs.includes(Path.dirname(argv1))) {
        return Path.basename(argv1)
    }
    // Anywhere else, only an absolute path is guaranteed to run.
    return Path.resolve(argv1)
}

// Rejects if `promise` has not settled after `ms` milliseconds.
function withTimeout(promise, ms) {
    let timer
    const timeout = new Promise((_, reject) => {
        timer = setTimeout(
            () => reject(new Error('Timed out after ' + ms + 'ms')),
            ms
        )
    })
    return Promise.race([promise, timeout]).finally(() => clearTimeout(timer))
}

// Best-effort: open the sign-in URL in the user's browser (CLI only).
function openBrowser(url) {
    const opener =
        process.platform === 'darwin'
            ? 'open'
            : process.platform === 'win32'
            ? 'explorer'
            : 'xdg-open'
    try {
        require('child_process')
            .spawn(opener, [url], { stdio: 'ignore', detached: true })
            .on('error', () => {})
            .unref()
    } catch {
        /* best effort */
    }
}

// Accept a bare access token or a whole pasted "<cmd> login <token>" line.
function extractToken(input) {
    input = input.trim()
    const m = /\blogin\s+(?:-r\s+|--readonly\s+)?(.+)$/s.exec(input)
    return (m ? m[1] : input).trim()
}

function parseLoginArgs(args) {
    const options = {}
    const rest = []
    for (let i = 0; i < args.length; i++) {
        const arg = args[i]
        switch (arg) {
            case '-r':
            case '--readonly':
                options.readonly = true
                break
            case '--device':
                options.device = true
                break
            case '--tenant':
            case '--client-id': {
                const value = args[++i]
                if (!value) {
                    throw Error(arg + ' needs a value')
                }
                options[arg === '--tenant' ? 'tenant' : 'clientId'] = value
                break
            }
            default:
                rest.push(arg)
        }
    }
    return { options, token: rest.join(' ') }
}

// Without a terminal (CI, or invoked by an agent) a browser on this machine
// may not be the one signing in, so use a device code instead: it can be
// entered on any device, and the command finishes on its own once it is.
// ($CI covers runners that allocate a pseudo-TTY; CI=false is the conventional
// opt-out, so honor it like ci-info does.)
function isInteractive() {
    return (
        process.stdin.isTTY && !(process.env.CI && process.env.CI !== 'false')
    )
}

async function login(args) {
    const { options, token } = parseLoginArgs(args)
    if (token) {
        // A hand-pasted access token works until it expires (about an hour)
        // and cannot be renewed.
        return (
            'Access token was saved to ' +
            (await tokenStore.write(extractToken(token)))
        )
    }
    if (options.device || !isInteractive()) {
        const device = await startDeviceLogin(tokenStore, options)
        console.log(
            '\n' +
                (device.message ||
                    'To sign in, open ' +
                        device.verificationUri +
                        ' and enter the code ' +
                        device.userCode +
                        '.')
        )
        await device.wait
    } else {
        const browser = await startBrowserLogin(tokenStore, options)
        console.log(
            '\nOpening your browser to sign in. If it does not open, visit:'
        )
        console.log(Colors.underline(browser.url))
        console.log(
            Colors.gray(
                "\nSigning in from another device? Press Ctrl-C and run '" +
                    commandName() +
                    " login --device'."
            )
        )
        openBrowser(browser.url)
        await browser.wait
    }
    return (
        (options.readonly ? 'Signed in read-only.' : 'Signed in.') +
        ' The token is saved to ' +
        TOKEN_PATH +
        ' and renews itself.'
    )
}

async function logout() {
    return (await tokenStore.remove())
        ? 'Signed out: removed ' + TOKEN_PATH
        : 'Not signed in.'
}

async function ln(args) {
    if (args.length !== 1) {
        console.error('usage: ln file')
    } else {
        const remote = sanitize(args[0])
        const result = await call(remote + '/createLink', 'POST', {
            type: 'view',
        })
        console.log(Colors.underline(result.link.webUrl))
    }
}

const MINUS_W = '-w'
const MINUS_RW = '-rw'

function shareCount(n) {
    return n + (n === 1 ? ' share' : ' shares')
}

async function chmod1(mode, remote) {
    remote = sanitize(remote)
    const result = await call(remote + '/permissions')
    // +w  x        POST (TODO(#34))
    // +w  read     PATCH (TODO(#34))
    // +w  write    NOP
    // -w  write    PATCH
    // -w  read     NOP
    // -rw write    DELETE
    // -rw read     DELETE
    // Count every share rather than keeping only the last outcome, so a
    // partial result ('-w' against a mix of write and read-only shares) is
    // reported as such. A share that errors still aborts the remainder, so
    // these counts describe the shares reached before that point.
    let changed = 0
    let unchanged = 0
    for (const cur of result.value) {
        if (mode === MINUS_RW) {
            // Revoking a permission answers 204 No Content, so use del()
            // rather than call() -- the latter parses a JSON body that isn't
            // there, which threw after revoking the first share and left the
            // rest in place.
            await del(remote + '/permissions/' + cur.id)
            ++changed
        } else if (cur.roles[0] === 'write') {
            // FIXME: generic 'edit' links cannot be patched to be read only
            await call(remote + '/permissions/' + cur.id, 'PATCH', {
                roles: ['read'],
            })
            ++changed
        } else {
            ++unchanged
        }
    }
    if (!changed) {
        return 'Nothing was changed'
    }
    const verb = mode === MINUS_RW ? 'revoked' : 'made read-only'
    return (
        shareCount(changed) +
        ' ' +
        verb +
        (unchanged ? ', ' + shareCount(unchanged) + ' already read-only' : '')
    )
}

async function chmod(args) {
    if (args.length < 2) {
        console.error('usage: chmod mode file ...')
    } else {
        let mode = args[0]
        switch (mode) {
            case '0600':
            case '0700':
            case '600':
            case '700':
            case 'g-rw':
            case 'o-rw':
            case 'go-rw':
            case 'og-rw':
            case '-rw':
                mode = MINUS_RW
                break

            case '0644':
            case '0744':
            case '644':
            case '744':
            case 'g-w':
            case 'o-w':
            case 'go-w':
            case 'og-w':
            case '-w':
                mode = MINUS_W
                break

            default:
                console.error('chmod: Invalid file mode:', mode)
                return
        }

        for (const cur of args.slice(1)) {
            // chmod1 reports whether it found anything to change; say so
            // instead of exiting silently either way.
            console.log(`${cur}: ${await chmod1(mode, cur)}`)
        }
    }
}

async function sendmail1(email, file) {
    const payload = {
        requireSignIn: true,
        sendInvitation: true,
        roles: ['write'],
        recipients: [{ email: email }],
        // "message": "You were invited by x to access y"
    }
    const remote = sanitize(file)
    const result = await call(remote + '/invite', 'POST', payload)
    console.log(JSON.stringify(result, undefined, 2))
}

async function sendmail(args) {
    if (args.length < 2) {
        console.error('usage: sendmail file recipient ...')
    } else {
        const file = args[0]
        for (const cur of args.slice(1)) {
            await sendmail1(cur, file)
        }
    }
}

function getItem(file) {
    const remote = sanitize(file)
    return call(remote)
}

async function stat1(file) {
    const result = await getItem(file)
    console.log(JSON.stringify(result, undefined, 2))
}

async function stat(args) {
    if (args.length === 0) {
        args = ['']
    }
    for (const cur of args) {
        await stat1(cur)
    }
}

async function find_paged(cont, expression) {
    if (cont === undefined) {
        return
    }
    const result = await call(cont)
    result.value
        .filter(info => expression.dirOnly !== !info.folder)
        .filter(info => !expression.regex || expression.regex.test(info.name))
        .map(absolute)
        .forEach(file => {
            if (expression.print0) {
                process.stdout.write(file)
                process.stdout.write('\0')
            } else {
                console.log(file)
            }
        })
    await find_paged(result['@odata.nextLink'], expression)
    // Recurse into subfolders
    const folders = result.value.filter(info => info.folder)
    for (const info of folders) {
        await find_paged(sanitize(absolute(info)) + '/children', expression)
    }
}

function globToRegExp(glob, flags) {
    const regex = glob
        .replace(/([$^|{}().[\]+\\])/g, '\\$1')
        .replace(/\*/g, '.*')
        .replace(/\?/g, '.')
    return new RegExp('^' + regex + '$', flags)
}

async function find(args) {
    if (args.length === 0) {
        console.error(
            'usage: find path ... [-print0] [-name GLOB] [-iname GLOB] [-regex REGEX] [-iregex REGEX] [-type d|f]'
        )
    } else {
        const expression = {}
        for (let index = 0; index < args.length; ) {
            switch (args[index]) {
                case '-print0':
                    expression.print0 = args.splice(index, 1)
                    break
                case '-type':
                    // This is used as a tri-state: true, false, undefined
                    expression.dirOnly = args.splice(index, 2)[1] === 'd'
                    break
                case '-name':
                    expression.regex = globToRegExp(args.splice(index, 2)[1])
                    break
                case '-iname':
                    expression.regex = globToRegExp(
                        args.splice(index, 2)[1],
                        'i'
                    )
                    break
                case '-regex':
                    expression.regex = new RegExp(args.splice(index, 2)[1])
                    break
                case '-iregex':
                    expression.regex = new RegExp(args.splice(index, 2)[1], 'i')
                    break
                default:
                    index++
            }
        }
        for (const folder of args) {
            await find_paged(sanitize(folder) + '/children', expression)
        }
    }
}

// Graph's search function takes the query as an OData string literal, in
// which a single quote is written twice.
function searchUrl(query) {
    return (
        DRIVE +
        "/root/search(q='" +
        encodeURIComponent(query.replace(/'/g, "''")) +
        "')"
    )
}

/*
GET /me/drive/root/search(q='{query}')
Server-side full-text search across the whole drive, listing the paths of
matching files (like `grep -rl`). OneDrive pages the matches for us. The API
ignores any folder anchor, so the search is always global -- pipe to e.g.
`grep '^:/folder/'` to limit it to a subtree, or use `find -iname` to match
on filenames instead of contents.
*/
async function grep_paged(cont) {
    if (cont === undefined) {
        return
    }
    const result = await call(cont)
    result.value.map(absolute).forEach(file => console.log(file))
    await grep_paged(result['@odata.nextLink'])
}

async function grep(args) {
    if (args.length !== 1) {
        console.error(
            'usage: grep pattern   (full-text; use `find -iname` for filenames)'
        )
    } else {
        await grep_paged(searchUrl(args[0]))
    }
}

/*
Albums are "bundles" -- driveItems with a bundle facet whose bundle.album is
set. They live outside the folder hierarchy, so they are addressed by item id
rather than by path:
  GET    /me/drive/bundles?filter=bundle/album ne null   list albums
  POST   /me/drive/bundles                               create a bundle/album
  POST   /me/drive/bundles/{id}/children                 add an existing item (by id) to the bundle
  DELETE /me/drive/bundles/{id}/children/{item-id}       remove an item from the bundle (keeps the file)
Bundles exist on personal accounts only.
The album filter is not just an optimization: on accounts migrated to the new
photos stack, the unfiltered enumeration serves a stale pre-migration view
that misses newly created albums, while the filtered query hits the current
album index. (Deleting an album bundle is rejected with 403 by this API; that
needs the OneDrive web UI.)
*/
async function listAlbums() {
    const albums = []
    let cont = DRIVE + '/bundles?filter=bundle/album%20ne%20null'
    while (cont) {
        const result = await call(cont)
        for (const b of result.value) {
            if (b.bundle && b.bundle.album) {
                albums.push(b)
            }
        }
        cont = result['@odata.nextLink']
    }
    return albums
}

async function albumByName(name) {
    const album = (await listAlbums()).find(a => a.name === name)
    if (!album) {
        throw Error('No such album: ' + name)
    }
    return album
}

async function albumItems(album) {
    const items = []
    let cont = DRIVE + '/items/' + album.id + '/children'
    while (cont) {
        const result = await call(cont)
        items.push(...result.value)
        cont = result['@odata.nextLink']
    }
    return items
}

// Items in an album keep their real parent folder when it is on this drive,
// so show that path (usable with cp/cat/etc.). On accounts migrated to the
// new photos stack, album children are presented under the album itself on a
// separate internal drive (parentReference.path like /drives/b!…/root:/Album)
// -- no usable path there, so fall back to the bare name.
function albumItemPath(info) {
    const path = info.parentReference && info.parentReference.path
    return path && path.startsWith('/drive/root') ? absolute(info) : info.name
}

async function album(args) {
    const sub = args.shift()
    switch (sub) {
        case undefined:
        case 'ls': {
            if (args.length === 0) {
                for (const a of await listAlbums()) {
                    console.log(
                        padLeft(a.bundle.childCount, 4),
                        Colors.bold(Colors.blue(a.name))
                    )
                }
                return
            }
            for (const name of args) {
                const items = await albumItems(await albumByName(name))
                for (const info of items) {
                    console.log(albumItemPath(info))
                }
            }
            return
        }

        case 'create': {
            if (args.length !== 1) {
                return console.error('usage: album create name')
            }
            const result = await call(DRIVE + '/bundles', 'POST', {
                name: args[0],
                bundle: { album: {} },
                '@name.conflictBehavior': 'fail',
            })
            console.log(`album: created album '${result.name}'`, result.id)
            return
        }

        case 'add': {
            if (args.length < 2) {
                return console.error('usage: album add album file ...')
            }
            const target = await albumByName(args[0])
            for (const cur of args.slice(1)) {
                const info = await getItem(cur)
                await call(
                    DRIVE + '/bundles/' + target.id + '/children',
                    'POST',
                    {
                        id: info.id,
                    }
                )
                console.log(cur, '->', target.name)
            }
            return
        }

        case 'rm': {
            if (args.length < 2) {
                return console.error('usage: album rm album file ...')
            }
            const target = await albumByName(args[0])
            for (const cur of args.slice(1)) {
                const info = await getItem(cur)
                await del(
                    DRIVE + '/bundles/' + target.id + '/children/' + info.id
                )
                console.log(`removed '${cur}' from '${target.name}'`)
            }
            return
        }

        default:
            console.error('usage: album [ls [name ...]]')
            console.error('       album create name')
            console.error('       album add album file ...')
            console.error('       album rm album file ...')
    }
}

// --- MCP (Model Context Protocol) server -----------------------------------
// A read-only stdio MCP server, mirroring github.com/lionello/gdrive-mcp but
// for OneDrive. It reuses the low-level helpers above (call, getContent,
// sanitize, absolute) and only ever issues GET requests, so it cannot mutate
// the drive. Note: nothing here may write to stdout -- that is the JSON-RPC
// channel. The helpers only log to stderr, and only when stdout is a TTY
// (which it is not under MCP), so they stay silent.

// Structured equivalents of ls/grep/find that return data instead of printing.
async function listFolder(path) {
    const items = []
    let cont = sanitize(path) + '/children'
    while (cont) {
        const result = await call(cont)
        for (const f of result.value) {
            items.push({
                name: f.name,
                path: absolute(f),
                type: is_folder(f) ? 'folder' : 'file',
                size: f.size,
                lastModified: f.lastModifiedDateTime,
                ...(f.folder ? { childCount: f.folder.childCount } : {}),
            })
        }
        cont = result['@odata.nextLink']
    }
    return items
}

async function searchContent(query) {
    const paths = []
    let cont = searchUrl(query)
    while (cont) {
        const result = await call(cont)
        for (const f of result.value) {
            paths.push(absolute(f))
        }
        cont = result['@odata.nextLink']
    }
    return paths
}

async function findItems(path, expression, acc = []) {
    let cont = sanitize(path) + '/children'
    while (cont) {
        const result = await call(cont)
        for (const info of result.value) {
            const matchesType =
                expression.dirOnly === undefined ||
                expression.dirOnly === !!info.folder
            const matchesName =
                !expression.regex || expression.regex.test(info.name)
            if (matchesType && matchesName) {
                acc.push(absolute(info))
            }
        }
        // Recurse into subfolders found on this page.
        for (const info of result.value.filter(i => i.folder)) {
            await findItems(absolute(info), expression, acc)
        }
        cont = result['@odata.nextLink']
    }
    return acc
}

async function mcp() {
    const { McpServer } = require('@modelcontextprotocol/sdk/server/mcp.js')
    const {
        StdioServerTransport,
    } = require('@modelcontextprotocol/sdk/server/stdio.js')
    const { z } = require('zod')
    const { version } = require('../package.json')

    const server = new McpServer({ name: 'onedrive-cli', version })

    const asJson = data => ({
        content: [{ type: 'text', text: JSON.stringify(data, undefined, 2) }],
    })

    // Turn an auth/permission failure into an actionable login hint instead of a
    // bare API error, so the agent knows to (re-)authenticate via login_onedrive.
    const authHint = err => {
        if (err.path === TOKEN_PATH || err.code === 'ENOENT') {
            return 'Not logged in to OneDrive. Call login_onedrive to sign in, then retry.'
        }
        if (err.statusCode === 401 || err.code === 'unauthenticated') {
            return 'The OneDrive sign-in has expired and could not be renewed. Call login_onedrive to sign in again, then retry.'
        }
        if (err.statusCode === 403) {
            return 'Access denied -- the saved token may be read-only. Call login_onedrive with readonly:false for read-write access, then retry.'
        }
        return null
    }

    // registerTool wrapper: run the handler, but map auth errors to a login hint.
    const rawRegister = server.registerTool.bind(server)
    const register = (name, def, handler) =>
        rawRegister(name, def, async args => {
            try {
                return await handler(args)
            } catch (err) {
                const hint = authHint(err)
                if (hint)
                    return asJson({
                        ok: false,
                        needsLogin: true,
                        message: hint,
                    })
                throw err
            }
        })

    register(
        'list_onedrive_folder',
        {
            title: 'List OneDrive folder',
            description:
                'List the direct children (files and folders) of a OneDrive folder. Pass an empty string to list the drive root.',
            inputSchema: {
                path: z
                    .string()
                    .default('')
                    .describe(
                        "Remote folder path, e.g. 'Documents/Reports'. Empty string for the drive root."
                    ),
            },
        },
        async ({ path }) => asJson(await listFolder(path || ''))
    )

    register(
        'search_onedrive_content',
        {
            title: 'Search OneDrive (full-text)',
            description:
                'Full-text search across the whole drive (matches file names and contents). Returns the paths of matching items, like `grep -rl`.',
            inputSchema: {
                query: z.string().describe('The search query.'),
            },
        },
        async ({ query }) => asJson(await searchContent(query))
    )

    register(
        'find_onedrive_files',
        {
            title: 'Find OneDrive files by name',
            description:
                'Recursively find items by name under a folder, using a shell glob pattern (e.g. "*.pdf"). Optionally restrict to files or folders.',
            inputSchema: {
                path: z
                    .string()
                    .default('')
                    .describe(
                        'Folder to search under. Empty string for the drive root.'
                    ),
                name: z
                    .string()
                    .optional()
                    .describe(
                        'Case-insensitive glob matched against item names, e.g. "*.docx". Omit to match everything.'
                    ),
                type: z
                    .enum(['file', 'folder'])
                    .optional()
                    .describe('Restrict results to files or folders.'),
            },
        },
        async ({ path, name, type }) => {
            const expression = {}
            if (name) {
                expression.regex = globToRegExp(name, 'i')
            }
            if (type) {
                expression.dirOnly = type === 'folder'
            }
            return asJson(await findItems(path || '', expression))
        }
    )

    register(
        'read_onedrive_file',
        {
            title: 'Read OneDrive file',
            description:
                'Read a byte range of a file via an HTTP Range request, so only the requested bytes are downloaded (scales to large files). Returns the bytes decoded as UTF-8 plus totalBytes and hasMore so you can page. A range may split a line or a multi-byte UTF-8 character at either boundary. Binary files will be garbled.',
            inputSchema: {
                path: z
                    .string()
                    .describe("Remote file path, e.g. 'Documents/notes.txt'."),
                offset: z
                    .number()
                    .int()
                    .min(0)
                    .default(0)
                    .describe('Byte offset to start reading from.'),
                length: z
                    .number()
                    .int()
                    .min(1)
                    .max(1048576)
                    .default(65536)
                    .describe('Number of bytes to read (max 1 MiB).'),
            },
        },
        async ({ path, offset, length }) => {
            const { buffer, total } = await getRange(
                sanitize(path) + '/content',
                offset,
                length
            )
            return asJson({
                path,
                offset,
                bytesReturned: buffer.length,
                totalBytes: total,
                hasMore: total !== undefined && offset + buffer.length < total,
                content: buffer.toString('utf8'),
            })
        }
    )

    register(
        'list_onedrive_albums',
        {
            title: 'List OneDrive albums',
            description:
                'List the photo/video albums in the OneDrive, or the items inside one album. Albums live outside the folder hierarchy; the returned item paths are the real file locations, usable with the other tools.',
            inputSchema: {
                album: z
                    .string()
                    .optional()
                    .describe(
                        'Album name to list the contents of. Omit to list all albums.'
                    ),
            },
        },
        async ({ album }) => {
            if (album) {
                const items = await albumItems(await albumByName(album))
                return asJson(
                    items.map(f => ({
                        name: f.name,
                        path: albumItemPath(f),
                        type: is_folder(f) ? 'folder' : 'file',
                        size: f.size,
                        lastModified: f.lastModifiedDateTime,
                    }))
                )
            }
            return asJson(
                (await listAlbums()).map(a => ({
                    name: a.name,
                    itemCount: a.bundle.childCount,
                    created: a.createdDateTime,
                    lastModified: a.lastModifiedDateTime,
                }))
            )
        }
    )

    register(
        'stat_onedrive_item',
        {
            title: 'Stat OneDrive item',
            description: 'Return the full metadata for a file or folder.',
            inputSchema: {
                path: z
                    .string()
                    .default('')
                    .describe('Remote path. Empty string for the drive root.'),
            },
        },
        async ({ path }) => asJson(await getItem(path || ''))
    )

    register(
        'onedrive_storage',
        {
            title: 'OneDrive storage quota',
            description:
                'Report the storage quota (total, used, remaining) for the available drives.',
            inputSchema: {},
        },
        async () => {
            const result = await call('/me/drives')
            return asJson(
                result.value.map(d => ({
                    id: d.id,
                    type: d.driveType,
                    status: (d.quota && d.quota.state) || null,
                    quota: d.quota,
                }))
            )
        }
    )

    register(
        'login_onedrive',
        {
            title: 'Log in to OneDrive',
            description:
                'Authenticate to OneDrive when calls fail with an authentication error. By default it presents a browser sign-in link; the browser hands the result straight back to this server, so nothing sensitive passes through this conversation. With device:true it returns a short code for the user to enter at a Microsoft page on any device -- use that when the browser is not on this machine (SSH, dev containers). The sign-in renews itself afterwards.',
            inputSchema: {
                device: z
                    .boolean()
                    .default(false)
                    .describe(
                        'Sign in with a device code instead of a browser on this machine.'
                    ),
                readonly: z
                    .boolean()
                    .default(true)
                    .describe(
                        'Request read-only access (Files.Read.All). Defaults to true since this MCP server only reads; set false to grant read-write.'
                    ),
                token: z
                    .string()
                    .optional()
                    .describe(
                        'Fallback: an access token obtained elsewhere, saved as is. It expires in about an hour and cannot be renewed.'
                    ),
            },
        },
        async ({ device, readonly, token }) => {
            if (token) {
                await tokenStore.write(extractToken(token))
                return asJson({ ok: true, message: 'Access token saved.' })
            }

            if (device) {
                const login = await startDeviceLogin(tokenStore, { readonly })
                // Polling continues in the background and saves the token once
                // the user finishes; every request re-reads the token file.
                login.wait.catch(() => {})
                return asJson({
                    ok: false,
                    pending: true,
                    verificationUri: login.verificationUri,
                    userCode: login.userCode,
                    expiresInSeconds: login.expiresIn,
                    message:
                        'Ask the user to open verificationUri on any device and enter userCode. The token is saved automatically once they finish -- then retry the request.',
                })
            }

            const login = await startBrowserLogin(tokenStore, { readonly })

            // Only present the link via URL-mode elicitation if the client
            // actually advertises support -- attempting it otherwise makes the
            // client surface an "unsupported" error. When supported, wait for
            // the browser to come back to the loopback and finish here.
            const caps = server.server.getClientCapabilities()
            const canUrlElicit = !!(
                caps &&
                caps.elicitation &&
                caps.elicitation.url
            )
            if (canUrlElicit) {
                try {
                    const result = await server.server.elicitInput({
                        mode: 'url',
                        message:
                            'Sign in to OneDrive in your browser to authorize this server. The browser hands the sign-in back to this server directly; nothing is pasted here.',
                        url: login.url,
                        elicitationId: Crypto.randomBytes(8).toString('hex'),
                    })
                    if (result.action !== 'accept') {
                        login.cancel()
                        return asJson({
                            ok: false,
                            action: result.action,
                            message: 'Login was ' + result.action + '.',
                        })
                    }
                    await withTimeout(login.wait, 120000)
                    return asJson({ ok: true, message: 'Signed in.' })
                } catch {
                    // Presented, but the browser never came back in time.
                    login.cancel()
                    return asJson({
                        ok: false,
                        message:
                            'The browser sign-in did not complete (expected in dev containers, where the browser cannot reach this server). Call login_onedrive with device:true to sign in with a code instead.',
                    })
                }
            }

            // No URL-mode elicitation: this is NOT an error -- return the
            // sign-in URL for the agent to hand to the user, and keep listening
            // for a few minutes so the sign-in completes out-of-band.
            login.wait.catch(() => {})
            setTimeout(login.cancel, 5 * 60 * 1000).unref()
            return asJson({
                ok: false,
                pending: true,
                loginUrl: login.url,
                message:
                    'Ask the user to open loginUrl in a browser on this machine and sign in. The token is saved automatically -- then retry the request. If the browser is on another device, call login_onedrive with device:true instead.',
            })
        }
    )

    const transport = new StdioServerTransport()
    await server.connect(transport)
}

async function main(argv) {
    // Disable colors when piping to another command
    if (!process.env.FORCE_COLOR && !process.stdout.isTTY) {
        Colors.disable()
    }

    // `help` is the verb, but agents and people alike reach for the GNU-style
    // flags first, so -h/--help and -v/--version are aliases rather than
    // unknown commands. (Keep the comment out of the case list: a comment
    // between labels makes an empty case non-empty for no-fallthrough.)
    switch (argv[2]) {
        case undefined:
        case 'help':
        case '-h':
        case '--help':
            console.log(
                Colors.bold(
                    '\nOneDrive Command Line Interface (c) Lionello Lunesu'
                )
            )
            console.log(
                '\nusage: ' +
                    commandName() +
                    ' COMMAND [arguments]\n\ncommands: album albums cat chmod cp df find grep help ln login logout ls mcp mkdir mv rm sendmail stat wget'
            )
            return

        case '-v':
        case '--version':
            return console.log(VERSION)

        case 'album':
            return album(argv.slice(3))

        // Listing shortcut: `albums` = `album ls`, `albums NAME` = `album ls NAME`
        case 'albums':
            return album(['ls', ...argv.slice(3)])

        case 'cat':
            return cat(argv.slice(3))

        case 'chmod':
            return chmod(argv.slice(3))

        case 'cp':
            return cp(argv.slice(3))

        case 'df':
            return df()

        case 'find':
            return find(argv.slice(3))

        case 'grep':
            return grep(argv.slice(3))

        case 'ln':
            return ln(argv.slice(3))

        case 'login':
            return login(argv.slice(3))

        case 'logout':
            return logout()

        case 'ls':
            return ls(argv.slice(3))

        case 'mcp':
            return mcp()

        case 'mkdir':
            return mkdir(argv.slice(3))

        case 'mv':
            return mv(argv.slice(3))

        case 'rm':
            return rm(argv.slice(3))

        case 'sendmail':
            return sendmail(argv.slice(3))

        case 'stat':
            return stat(argv.slice(3))

        case 'wget':
            return wget(argv.slice(3))

        default:
            throw Error(
                'Unknown command: ' +
                    argv[2] +
                    "\nRun '" +
                    commandName() +
                    " help' for the list of commands."
            )
    }
}

main(process.argv).then(
    result => {
        if (result !== undefined) {
            console.log(Colors.green(result))
        }
    },
    err => {
        console.error(Colors.red(err.localizedMessage || err.message))
        debugPrint(err)
        // Auth failures: guide the user to re-authenticate. Exit -1 so xargs stops.
        // Only a missing *token file* means "not logged in"; any other ENOENT
        // is a local path that does not exist and is reported as such above.
        const relogin = "Run '" + commandName() + " login' to sign in."
        if (err.path === TOKEN_PATH) {
            console.error("You're not logged in. " + relogin)
            process.exitCode = -1
        } else if (err.statusCode === 401 || err.code === 'unauthenticated') {
            console.error(
                'Your sign-in has expired and could not be renewed. ' + relogin
            )
            process.exitCode = -1
        } else if (err.statusCode === 403) {
            console.error(
                'Access denied. If you signed in read-only (login -r), ' +
                    relogin.replace('to sign in', 'for read-write access')
            )
            process.exitCode = -1
        } else {
            process.exitCode = 1
        }
    }
)
